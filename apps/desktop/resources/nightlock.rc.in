#include <windows.h>

#define IDI_NIGHTLOCK 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Multi-resolution application icon for the executable and its shortcuts.
IDI_NIGHTLOCK ICON "@NIGHTLOCK_WINDOWS_ICON@"

// Process identity and DPI behavior. MinGW embeds resource ID 1 here; MSVC's
// manifest tool consumes and merges the generated .manifest source instead.
@NIGHTLOCK_WINDOWS_MANIFEST_RESOURCE@

// Native version metadata used by Explorer, Task Manager and inventory tools.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Nightlock contributors\0"
            VALUE "FileDescription", "Nightlock password manager\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "Nightlock\0"
            VALUE "LegalCopyright", "Copyright (C) Nightlock contributors\0"
            VALUE "OriginalFilename", "Nightlock.exe\0"
            VALUE "ProductName", "Nightlock\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
