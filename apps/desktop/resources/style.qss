QMainWindow {
    background: #FFFFFF;
}

QSplitter::handle {
    background: #D9D9D9;
}

QTreeView#groupTree {
    background: #FFFFFF;
    border: none;
    outline: none;
    font-family: Georgia;
    font-size: 17px;
    font-weight: bold;
    padding-top: 6px;
    show-decoration-selected: 1;
}
QTreeView#groupTree::item {
    height: 26px;
    border: none;
    color: #111111;
    padding-left: 11px;
}
QTreeView#groupTree::item:selected {
    background: #000000;
    color: #FFFFFF;
}
QTreeView#groupTree::branch {
    background: transparent;
    image: none;
    border-image: none;
}
QTreeView#groupTree::branch:selected {
    background: #000000;
}

QListView#entryList {
    background: #FFFFFF;
    border: none;
    outline: none;
}

QFrame#listHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E4E4E4;
}
QLabel#itemsCount {
    font-size: 13px;
    font-weight: 600;
    color: #1A1A1A;
}
QLabel#itemsPath {
    font-size: 12px;
    color: #6E6E6E;
}

QScrollArea {
    background: #FFFFFF;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: #FFFFFF;
}

QLabel#detailTitle {
    font-family: Georgia;
    font-size: 26px;
    font-weight: bold;
    color: #000000;
}
QLabel#detailNote {
    font-size: 12px;
    color: #4A4A4A;
}
QLabel#metaHeader {
    font-family: Georgia;
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

QFrame#card {
    background: #FBF9FB;
    border: 1px solid #E3E3E3;
    border-radius: 9px;
}
QFrame#fieldRow {
    border: none;
    border-bottom: 1px solid #EDEDED;
    background: transparent;
}
QFrame#fieldRow[lastVisible="true"] {
    border-bottom: none;
}
QFrame#fieldRowLast {
    border: none;
    background: transparent;
}
QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #141414;
}
QLabel#fieldValue {
    font-size: 12px;
    color: #3C3C3C;
}
