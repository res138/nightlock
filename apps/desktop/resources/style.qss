QMainWindow {
    background: @bg;
}

QSplitter::handle {
    background: @border;
}

QTreeView#groupTree {
    background: @bg;
    border: none;
    outline: none;
    font-family: "@font-secondary";
    font-size: 17px;
    font-weight: bold;
    /* the toolbar header above clears the traffic lights; keep a bit
       of air between its border and the first row */
    padding-top: 6px;
    show-decoration-selected: 1;
}
QTreeView#groupTree::item {
    height: 26px;
    border: none;
    color: @text;
    padding-left: 11px;
}
QTreeView#groupTree::item:selected {
    background: @accent;
    color: @accent-text;
}
QTreeView#groupTree::branch {
    background: transparent;
    image: none;
    border-image: none;
}
QTreeView#groupTree::branch:selected {
    background: @accent;
}

QListView#entryList {
    background: @bg;
    border: none;
    outline: none;
}

QFrame#listHeader,
QFrame#treeHeader {
    background: @bg;
    border: none;
    border-bottom: 1px solid @border-faint;
}
QToolButton#headerIconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
}
QToolButton#headerIconButton[active="true"] {
    background: @overlay-active;
}
QLabel#itemsCount {
    font-size: 13px;
    font-weight: 600;
    color: @text;
}
QLabel#itemsPath {
    font-size: 12px;
    color: @text-muted;
}

QScrollArea {
    background: @bg;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: @bg;
}

QLabel#detailTitle {
    font-family: "@font-secondary";
    font-size: 26px;
    font-weight: bold;
    color: @text-strong;
}
QLabel#detailNote {
    font-size: 12px;
    color: @text-note;
}
QLabel#metaHeader {
    font-family: "@font-secondary";
    font-size: 20px;
    font-weight: bold;
    color: @text-strong;
}

QFrame#card {
    background: @bg-card;
    border: 1px solid @border-soft;
    border-radius: 9px;
}
QFrame#seedStack {
    background: transparent;
    border: none;
}
QFrame#seedWordsCard {
    background: @bg-card;
    border: 1px solid @border-soft;
    border-radius: 9px;
}
QFrame#seedCopyInset {
    background: transparent;
    border: none;
}
QFrame#seedCopyBar {
    background: @bg-card;
    border: 1px solid @border-soft;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
QFrame#fieldRow {
    border: none;
    background: transparent;
}
QFrame#fieldSeparator {
    border: none;
    background: @border-row;
}
QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: @text;
}
QLabel#fieldValue {
    font-size: 12px;
    color: @text-value;
}

/* Folder renaming happens in place: the editor melts into the black
   selected row (black on black, white text), so it reads as editing
   the row's own text rather than a popped-up input panel. */
QTreeView#groupTree QLineEdit {
    background: @accent;
    border: 1px solid @accent;
    border-radius: 4px;
    /* lines the editor text up with the row text it replaces */
    padding-left: 1px;
    color: @accent-text;
    /* the select-all highlight stays a soft band instead of flipping
       the text back to a white block */
    selection-background-color: rgba(255, 255, 255, 0.3);
    selection-color: @accent-text;
}

QDialog#entryEditDialog {
    background: @bg;
}
QLabel#dialogFieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: @text-muted;
}
QDialog#entryEditDialog QLineEdit,
QDialog#entryEditDialog QPlainTextEdit {
    background: transparent;
    border: none;
    border-bottom: 1px solid @border-soft;
    border-radius: 0;
    padding: 7px 2px 6px 2px;
    font-size: 13px;
    color: @text;
    selection-background-color: @accent;
    selection-color: @accent-text;
}
QToolButton#iconPickerButton {
    background: transparent;
    border: none;
    border-radius: 0;
}
QToolButton#iconPickerButton:checked {
    border: none;
    border-bottom: 2px solid @text-muted;
    border-radius: 0;
}
QPushButton#primaryButton {
    background: @accent;
    color: @accent-text;
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background: @accent-hover;
}
QPushButton#primaryButton:disabled {
    background: @disabled;
}
QPushButton#generatorButton {
    background: @accent;
    color: @accent-text;
    border: none;
    border-radius: 12px;
    padding: 12px 0;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#generatorButton:disabled {
    background: @disabled;
}
QPushButton#ghostButton {
    background: @bg-elevated;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#ghostButton:hover {
    background: @hover;
}

QToolButton#iconPickerAdd {
    background: transparent;
    border: none;
    font-size: 20px;
    color: @text-strong;
}
QPushButton#customFieldAdd {
    background: transparent;
    border: none;
    padding: 2px 0;
    color: @text;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#customFieldRemove {
    background: transparent;
    border: none;
    color: @text-muted;
    font-size: 20px;
    min-width: 24px;
    max-width: 24px;
}

QDialog#passwordGeneratorWindow {
    background: @bg;
}
QLabel#generatorSubtitle,
QLabel#generatorStrength,
QLabel#generatorRange {
    font-size: 12px;
    color: @text-muted;
}
QLabel#generatorLabel {
    font-size: 12px;
    font-weight: 600;
    color: @text;
}
QLabel#generatorLengthValue {
    min-width: 32px;
    padding: 3px 7px;
    border-radius: 6px;
    background: @hover-tint;
    color: @text;
    font-size: 12px;
    font-weight: 600;
}
QSlider#generatorLength::groove:horizontal {
    height: 4px;
    border: none;
    border-radius: 2px;
    background: @border-strong;
}
QSlider#generatorLength::sub-page:horizontal {
    border: none;
    border-radius: 2px;
    background: @accent;
}
QSlider#generatorLength::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border: 2px solid @bg;
    border-radius: 8px;
    background: @accent;
}

QWidget#searchWindow {
    background: @bg;
}
QWidget#searchWindow QLineEdit#searchField {
    background: @bg-input;
    border: 1px solid @border-soft;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: @text;
    selection-background-color: @accent;
    selection-color: @accent-text;
}
QWidget#searchWindow QLineEdit#searchField:focus {
    background: @bg-input-focus;
    border: 1px solid @border-focus;
}
QListWidget#searchResults {
    background: transparent;
    border: none;
}
QLabel#searchEmpty {
    font-size: 12px;
    color: @text-faint;
    padding: 8px 0;
}

QListView#iconGallery {
    background: transparent;
    border: none;
    outline: none;
}
QListView#iconGallery::item {
    border-radius: 9px;
}

QScrollArea[floatingWindow="true"] {
    background: transparent;
}
QScrollArea[floatingWindow="true"] > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 2px 2px 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 2px 2px 2px;
}
QScrollBar::handle:vertical {
    background: @scroll;
    border-radius: 2px;
    min-height: 22px;
}
QScrollBar::handle:horizontal {
    background: @scroll;
    border-radius: 2px;
    min-width: 22px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: @scroll-hover;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolButton#graphZoomButton {
    background: @bg-elevated;
    border: 1px solid @border-strong;
    border-radius: 14px;
    font-size: 16px;
    color: @text;
}
QToolButton#graphZoomButton:hover {
    background: @hover-tint;
}
QToolButton#graphZoomButton:pressed {
    background: @pressed;
}
/* The slash spans the full ascent, so it needs a smaller font to
   render the same visual size as the +/− glyphs. */
QToolButton#graphZoomButton[glyph="slash"] {
    font-size: 12px;
}

QWidget#lockScreen {
    background: @bg;
}
QLabel#lockTitle {
    font-size: 20px;
    font-weight: 700;
    color: @text;
}
QLineEdit#lockField {
    background: @bg-input;
    border: 1px solid @border-soft;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 14px;
    color: @text;
    selection-background-color: @accent;
    selection-color: @accent-text;
}
QLineEdit#lockField:focus {
    background: @bg-input-focus;
    border: 1px solid @border-focus;
}
QLineEdit#lockField[error="true"] {
    border: 1px solid #D2605E;
}
QToolButton#lockUnlock {
    background: @accent;
    color: @accent-text;
    border: none;
    border-radius: 10px;
    font-size: 18px;
}
QLabel#lockError {
    font-size: 12px;
    color: #D2605E;
}
QLabel#lockLink {
    font-size: 12px;
}
QLabel#lockPath {
    font-size: 12px;
    color: @text-muted;
}
QPushButton#lockSelectFolder {
    background: @bg-input;
    border: 1px solid @border-soft;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    color: @text;
}
QPushButton#lockSelectFolder:hover {
    background: @bg-input-focus;
}

QWidget#settingsWindow {
    background: @bg;
}
QFrame#settingsNavPane {
    background: @bg-sidebar;
    border: none;
    border-right: 1px solid @border;
}
QListWidget#settingsNav {
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
}
QListWidget#settingsNav::item {
    height: 30px;
    border-radius: 8px;
    padding-left: 8px;
    margin: 1px 10px;
    color: @text;
}
QListWidget#settingsNav::item:selected {
    background: @accent;
    color: @accent-text;
}
QFrame#settingsRow {
    border: none;
    border-bottom: 1px solid @border-row;
    background: transparent;
}
QFrame#settingsRow[last="true"] {
    border-bottom: none;
}
QLabel#settingsRowTitle {
    font-size: 13px;
    font-weight: 600;
    color: @text;
}
QLabel#settingsRowDesc {
    font-size: 12px;
    color: @text-muted;
}
QPushButton#settingsKeycap {
    background: @hover-tint;
    border: 1px solid @border-strong;
    border-radius: 6px;
    padding: 4px 9px;
    font-size: 12px;
    font-weight: 600;
    color: @text;
}
QPushButton#settingsKeycap:hover {
    background: @hover-strong;
}
QPushButton#settingsKeycap[recording="true"] {
    background: @bg-input-focus;
    border: 1px solid @accent;
    color: @text-muted;
}
QPushButton#settingsInlineButton {
    background: transparent;
    border: none;
    padding: 8px 4px;
    font-size: 13px;
    font-weight: 600;
    color: @text;
}
QPushButton#settingsInlineButton:hover {
    color: @text-muted;
}
QPushButton#settingsInlineButton:disabled {
    color: @text-faint;
}
QLineEdit#settingsNumberField,
QLineEdit#settingsPasswordField {
    background: @bg-input;
    border: 1px solid @border-soft;
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 13px;
    color: @text;
    selection-background-color: @accent;
    selection-color: @accent-text;
}
QLineEdit#settingsNumberField:focus,
QLineEdit#settingsPasswordField:focus {
    background: @bg-input-focus;
    border: 1px solid @accent;
}

QPushButton#showInGraph {
    background: @accent;
    color: @accent-text;
    border: none;
    border-radius: 12px;
    padding: 12px 0;
    font-size: 13px;
    font-weight: 600;
}
