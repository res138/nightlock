QMainWindow {
    background: #FFFFFF;
}

QSplitter::handle {
    background: #EAEAEA;
}

QTreeView#groupTree {
    background: #FFFFFF;
    border: none;
    outline: none;
    font-family: Georgia;
    font-size: 17px;
    font-weight: bold;
    /* the toolbar header above clears the traffic lights; keep a bit
       of air between its border and the first row */
    padding-top: 6px;
    show-decoration-selected: 1;
}
QTreeView#groupTree::item {
    height: 26px;
    border: none;
    color: #111111;
    padding-left: 11px;
}
QTreeView#groupTree::item:selected {
    background: #000000;
    color: #FFFFFF;
}
QTreeView#groupTree::branch {
    background: transparent;
    image: none;
    border-image: none;
}
QTreeView#groupTree::branch:selected {
    background: #000000;
}

QListView#entryList {
    background: #FFFFFF;
    border: none;
    outline: none;
}

QFrame#listHeader,
QFrame#treeHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #F0F0F0;
}
QToolButton#headerIconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
}
QToolButton#headerIconButton[active="true"] {
    background: rgba(0, 0, 0, 0.08);
}
QLabel#itemsCount {
    font-size: 13px;
    font-weight: 600;
    color: #1A1A1A;
}
QLabel#itemsPath {
    font-size: 12px;
    color: #6E6E6E;
}

QScrollArea {
    background: #FFFFFF;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: #FFFFFF;
}

QLabel#detailTitle {
    font-family: Georgia;
    font-size: 26px;
    font-weight: bold;
    color: #000000;
}
QLabel#detailNote {
    font-size: 12px;
    color: #4A4A4A;
}
QLabel#metaHeader {
    font-family: Georgia;
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

QFrame#card {
    background: #FDFCFD;
    border: 1px solid #EFEFEF;
    border-radius: 9px;
}
QFrame#fieldRow {
    border: none;
    border-bottom: 1px solid #F5F5F5;
    background: transparent;
}
QFrame#fieldRow[lastVisible="true"] {
    border-bottom: none;
}
QFrame#fieldRowLast {
    border: none;
    background: transparent;
}
QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #141414;
}
QLabel#fieldValue {
    font-size: 12px;
    color: #3C3C3C;
}

/* Folder renaming happens in place: the editor melts into the black
   selected row (black on black, white text), so it reads as editing
   the row's own text rather than a popped-up input panel. */
QTreeView#groupTree QLineEdit {
    background: #000000;
    border: 1px solid #000000;
    border-radius: 4px;
    /* lines the editor text up with the row text it replaces */
    padding-left: 1px;
    color: #FFFFFF;
    /* the select-all highlight stays a soft band instead of flipping
       the text back to a white block */
    selection-background-color: rgba(255, 255, 255, 0.3);
    selection-color: #FFFFFF;
}

QDialog#entryEditDialog {
    background: #FFFFFF;
}
QLabel#dialogFieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #141414;
}
QDialog#entryEditDialog QLineEdit,
QDialog#entryEditDialog QPlainTextEdit {
    background: #FBF9FB;
    border: 1px solid #EFEFEF;
    border-radius: 7px;
    padding: 7px 10px;
    font-size: 13px;
    color: #111111;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}
QDialog#entryEditDialog QLineEdit:focus,
QDialog#entryEditDialog QPlainTextEdit:focus {
    background: #FFFFFF;
    border: 1px solid #000000;
}
QToolButton#iconPickerButton {
    background: transparent;
    border: none;
    border-radius: 10px;
}
QToolButton#iconPickerButton:checked {
    border: 1px solid #000000;
}
QPushButton#primaryButton {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background: #262626;
}
QPushButton#primaryButton:disabled {
    background: #BDBDBD;
}
QPushButton#ghostButton {
    background: #FFFFFF;
    color: #111111;
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#ghostButton:hover {
    background: #F5F5F5;
}

QToolButton#iconPickerAdd {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #000000;
}

QWidget#searchWindow {
    background: #FFFFFF;
}
QWidget#searchWindow QLineEdit#searchField {
    background: #FBF9FB;
    border: 1px solid #EFEFEF;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #111111;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}
QWidget#searchWindow QLineEdit#searchField:focus {
    background: #FFFFFF;
    border: 1px solid #D9D7DC;
}
QListWidget#searchResults {
    background: transparent;
    border: none;
}
QLabel#searchEmpty {
    font-size: 12px;
    color: #8A8792;
    padding: 8px 0;
}

QListView#iconGallery {
    background: transparent;
    border: none;
    outline: none;
}
QListView#iconGallery::item {
    border-radius: 9px;
}
QListView#iconGallery::item:hover {
    background: rgba(0, 0, 0, 0.07);
}

QScrollArea[floatingWindow="true"] {
    background: transparent;
}
QScrollArea[floatingWindow="true"] > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 2px 2px 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 2px 2px 2px;
}
QScrollBar::handle:vertical {
    background: #CFCFCF;
    border-radius: 2px;
    min-height: 22px;
}
QScrollBar::handle:horizontal {
    background: #CFCFCF;
    border-radius: 2px;
    min-width: 22px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #A9A9A9;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolButton#graphZoomButton {
    background: #FFFFFF;
    border: 1px solid #E6E4E8;
    border-radius: 14px;
    font-size: 16px;
    color: #111111;
}
QToolButton#graphZoomButton:hover {
    background: #F5F3F6;
}
QToolButton#graphZoomButton:pressed {
    background: #EDEBEF;
}

QWidget#lockScreen {
    background: #FFFFFF;
}
QLabel#lockTitle {
    font-size: 20px;
    font-weight: 700;
    color: #111111;
}
QLineEdit#lockField {
    background: #FBF9FB;
    border: 1px solid #EFEFEF;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 14px;
    color: #111111;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}
QLineEdit#lockField:focus {
    background: #FFFFFF;
    border: 1px solid #D9D7DC;
}
QLineEdit#lockField[error="true"] {
    border: 1px solid #D2605E;
}
QToolButton#lockUnlock {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 18px;
}
QLabel#lockError {
    font-size: 12px;
    color: #D2605E;
}
QLabel#lockLink {
    font-size: 12px;
}

QPushButton#showInGraph {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 12px 0;
    font-size: 13px;
    font-weight: 600;
}
